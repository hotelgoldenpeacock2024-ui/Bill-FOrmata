# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL.
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase anonymous API key.
SUPABASE_ANON_KEY="your-anon-key"

# Signzy (Karza) API Integration
SIGNZY_API_KEY=

# Sandbox.co.in API Integration
# Get your API Key and Secret from Sandbox Dashboard
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

# WhatsApp Daily Stay Reminders Integration
WHATSAPP_PROVIDER="twilio" # 'twilio' or 'meta'
WHATSAPP_RECIPIENT_PHONE="8777264725"
CRON_SECRET="your-secure-cron-webhook-secret"

# Twilio Credentials (If WHATSAPP_PROVIDER="twilio")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886" # Sandbox default

# Meta Cloud API Credentials (If WHATSAPP_PROVIDER="meta")
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=

# Telegram Daily Stay Reminders Integration (Free & Easy alternative)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
